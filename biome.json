{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/.wrangler",
      "!**/.glass",
      "!**/coverage",
      "!**/.stryker-tmp",
      "!.github/workflows/glass.yml",
      "!site/public/demo",
      "!packages/dashboard/src/components/world-paths.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": false
  },
  "overrides": [
    {
      "includes": [".changeset/*.md"],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
