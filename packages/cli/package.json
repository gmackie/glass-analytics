{
  "name": "dataflare-cli",
  "version": "0.8.2",
  "description": "Agent-first analytics in your own Cloudflare account. `npx dataflare-cli init` deploys it.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "dataflare": "dist/glass.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ISNIT0/glass-analytics.git",
