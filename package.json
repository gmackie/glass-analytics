{
  "name": "dataflare-monorepo",
  "private": true,
  "type": "module",
  "description": "Agent-first, open-source analytics that runs in your own Cloudflare account.",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "^26.13.1",
    "pnpm": "^12.21.0"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json && pnpm --filter @dataflare/mobile typecheck",
    "test": "node --test \"packages/*/test/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "test:e2e": "node scripts/build.ts && node --test \"e2e/*.test.ts\"",
    "quality": "node scripts/quality.ts check",
    "quality:update": "node scripts/quality.ts update",
    "quality:hotspots": "node scripts/quality.ts hotspots",
    "mutation": "node scripts/mutation.ts",
    "dev": "node scripts/build.ts && node packages/worker/test/server.ts",
    "site:build": "node scripts/build.ts && node site/build.ts",
    "site:assets": "node scripts/site-assets.ts",
    "site:dev": "node scripts/build.ts && node site/build.ts && pnpm --filter @dataflare/site exec wrangler dev",
    "dev:wrangler": "node scripts/build.ts && pnpm --filter @dataflare/worker exec wrangler dev",
    "lint": "oxlint",
    "knip": "knip",
    "size": "node scripts/size.ts",
    "format": "biome format --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm knip && pnpm test && pnpm quality",
    "changeset": "changeset",
    "version-packages": "changeset version && biome format --write packages/cli/CHANGELOG.md packages/web/CHANGELOG.md && node scripts/sync-version.ts",
    "release": "pnpm build && changeset publish",
    "format:check": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@changesets/cli": "3.0.3",
    "@stryker-mutator/core": "10.1.1",
    "@types/node": "26.6.6",
    "@typescript/typescript6": "6.0.2",
    "esbuild": "0.28.2",
    "knip": "6.46.0",
    "marked": "18.2.1",
    "oxlint": "1.94.0",
    "playwright": "1.65.1",
    "typescript": "7.0.2"
  }
}
