// Deployed by ForgeGraph from this fork (DATFLR-7). The Worker bundle and migrations are built from
// source by `pnpm build`; edit this file, not the CLI. Never run `dataflare upgrade` here.
{
  "name": "dataflare-observe",
  "main": "../../../packages/worker/dist/worker.js",
  "compatibility_date": "2026-11-17",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dataflare-observe",
      "database_id": "5bdf79c2-33b1-4edb-a5b3-393295e778b8",
      "migrations_dir": "../../../packages/worker/dist/migrations"
    }
  ],
  "vars": {
    "GLASS_PUBLIC_URL": "https://observe.gmac.io",
    "GLASS_DASHBOARD_ANALYTICS_PROJECT": "dataflare",
    "GLASS_ACCESS_AUD": "29efb15247e0a2d4e5ffd47186980d5d81393865b75335d8440264aeb55dd65a",
    "GLASS_ACCESS_ADMIN_EMAIL_SHA256": "1d8993f3366b64190254d6416a59f2b757a5d97b9d81e812d1655e817a68018b",
    "GLASS_STORE": "lake",
    "LAKE_BUCKET": "dataflare-observe-data",
    "LAKE_NAMESPACE": "glass",
    "LAKE_VERSIONS": "1",
    "CF_ACCOUNT_ID": "c07a7e704db1808e1fff91bed2b1cd49",
    "GLASS_RETENTION_DAYS": "365"
  },
  // Every five minutes, as `dataflare init` sets it: scheduled flag changes, alerts and exports;
  // hourly housekeeping runs on one tick an hour (DATFLR-30).
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "pipelines": [
    {
      "binding": "EVENTS_STREAM",
      "stream": "0236827d11da4409abb4f2f2d29cc027"
    },
    {
      "binding": "IDENTITIES_STREAM",
      "stream": "fcf827f3d3e74ae0be8bbd789ffea53e"
    }
  ],
  // Destination delivery (0.9). The queues were created by `dataflare init` on 2026-11-24 (DATFLR-30).
  "queues": {
    "producers": [
      {
        "binding": "DELIVERIES",
        "queue": "dataflare-observe-deliveries"
      }
    ],
    "consumers": [
      {
        "queue": "dataflare-observe-deliveries",
        "max_batch_size": 25,
        "max_batch_timeout": 5,
        "max_retries": 8,
        "dead_letter_queue": "dataflare-observe-deliveries-dlq"
      }
    ]
  }
}
